SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF) TDO (000000FF4) MASK (FFFFFFFFE);  // [8/16] RDBUFF TDO ?= 0x000000FF (+ACK=OK)
//   ... 50% complete (8/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (000010084) SMASK (FFFFFFFFF);  // [9/16] TAR ← 0x00001008
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [9/16] Read DRW from 0x00001008  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [9/16] RDBUFF (TDO not checked)
//   ... 56% complete (9/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (0000100C4) SMASK (FFFFFFFFF);  // [10/16] TAR ← 0x0000100C
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [10/16] Read DRW from 0x0000100C  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [10/16] RDBUFF (TDO not checked)
//   ... 62% complete (10/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00001A004) SMASK (FFFFFFFFF);  // [11/16] TAR ← 0x00001A00
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (ABCD0001C) SMASK (FFFFFFFFF);  // [11/16] DRW ← 0xABCD0001  → 0x00001A00
