SDR 36 TDI (000010004) SMASK (FFFFFFFFF);  // [2/31] TAR ← 0x00001000  (lower, full=0x0000000000001000)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (000000006) SMASK (FFFFFFFFF);  // Read CTRL/STAT (wait for last operation)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (DEADBEEFC) SMASK (FFFFFFFFF);  // [2/31] DRW ← 0xDEADBEEF  → 0x00001000 (WAIT1800)
RUNTEST 1800 TCK;
//   ... 6% complete (2/31 commands)
