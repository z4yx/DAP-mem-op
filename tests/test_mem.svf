SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00001A004) SMASK (FFFFFFFFF);  // [13/15] TAR ← 0x00001A00
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [13/15] Read DRW from 0x00001A00  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF) TDO (ABCD00014) MASK (FFFFFFFFE);  // [13/15] RDBUFF TDO ?= 0xABCD0001 (+ACK=OK)
//   ... 86% complete (13/15 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00001A044) SMASK (FFFFFFFFF);  // [14/15] TAR ← 0x00001A04
SIR 10 TDI (2FF) SMASK (3FF);
