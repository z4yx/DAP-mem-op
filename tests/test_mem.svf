// ============================================================================
//  SVF — Serial Vector Format
//  Target:  ARM Cortex-R52 (ARM IHI0031H / ADIv6)
//  Chain:   Daisy chain:  PL_TAP  → [ARM_DAP]  (target marked [...])
//  Generated by: svf_gen.py
// ============================================================================
TRST OFF;
ENDIR IDLE;
ENDDR IDLE;
STATE RESET IDLE;
// ======================================================================
// PHASE 1: JTAG Reset & Device Identification
// ======================================================================

RUNTEST 10 TCK;
SIR 10 TDI (3BF) SMASK (3FF);
SDR 33 TDI (000000000) SMASK (1FFFFFFFF);  // Read IDCODE — TDO receives device ID
RUNTEST 10 TCK;
// ======================================================================
// PHASE 2: Power-Up the Debug & System Domains
// ======================================================================

SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (500002004) SMASK (FFFFFFFFF);  // Request CDBGPWRUP + CSYSPWRUP, TRNCNT=512
RUNTEST 50 TCK;
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (000000006) SMASK (FFFFFFFFF);  // Read CTRL/STAT (result in next transaction)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // Read RDBUFF — TDO = CTRL/STAT value; check ACK bits
RUNTEST 10 TCK;
// ======================================================================
// PHASE 3: Select MEM-AP via DP.SELECT
// ======================================================================

SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (000000008) SMASK (FFFFFFFFF);  // SELECT APSEL=0, APBANKSEL=0
RUNTEST 10 TCK;
// ======================================================================
// PHASE 4: Configure MEM-AP (CSW)
// ======================================================================

SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (030000420) SMASK (FFFFFFFFF);  // CSW: 32-bit, ADDRINC_OFF, DeviceEn, DbgSwEnable
RUNTEST 10 TCK;
// ======================================================================
// PHASE 5: Execute 16 commands (15 R/W, 1 wait)
//         Data width: 32-bit
//         Mode: explicit TAR per access (ADDRINC_OFF)
// ======================================================================

// [1/16] RUNTEST 100 TCK (wait 100 cycles)
RUNTEST 100 TCK;

SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (000010004) SMASK (FFFFFFFFF);  // [2/16] TAR ← 0x00001000
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [2/16] Read DRW from 0x00001000  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF) TDO (DEADBEEF4) MASK (FFFFFFFFE);  // [2/16] RDBUFF TDO ?= 0xDEADBEEF (+ACK=OK)
//   ... 12% complete (2/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (000010044) SMASK (FFFFFFFFF);  // [3/16] TAR ← 0x00001004
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [3/16] Read DRW from 0x00001004  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF) TDO (CAFEBABE4) MASK (FFFFFFFFE);  // [3/16] RDBUFF TDO ?= 0xCAFEBABE (+ACK=OK)
//   ... 18% complete (3/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (000010084) SMASK (FFFFFFFFF);  // [4/16] TAR ← 0x00001008
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [4/16] Read DRW from 0x00001008  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF) TDO (123456784) MASK (FFFFFFFFE);  // [4/16] RDBUFF TDO ?= 0x12345678 (+ACK=OK)
//   ... 25% complete (4/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (0000100C4) SMASK (FFFFFFFFF);  // [5/16] TAR ← 0x0000100C
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (000000FFC) SMASK (FFFFFFFFF);  // [5/16] DRW ← 0x000000FF  → 0x0000100C
//   ... 31% complete (5/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (000010004) SMASK (FFFFFFFFF);  // [6/16] TAR ← 0x00001000
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [6/16] Read DRW from 0x00001000  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF) TDO (DEADBEEF4) MASK (FFFFFFFFE);  // [6/16] RDBUFF TDO ?= 0xDEADBEEF (+ACK=OK)
//   ... 37% complete (6/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (000010044) SMASK (FFFFFFFFF);  // [7/16] TAR ← 0x00001004
SIR 10 TDI (2FF) SMASK (3FF);
