SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00001A084) SMASK (FFFFFFFFF);  // [13/16] TAR ← 0x00001A08
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (ABCD0003C) SMASK (FFFFFFFFF);  // [13/16] DRW ← 0xABCD0003  → 0x00001A08
//   ... 81% complete (13/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00001A004) SMASK (FFFFFFFFF);  // [14/16] TAR ← 0x00001A00
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [14/16] Read DRW from 0x00001A00  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF) TDO (ABCD00014) MASK (FFFFFFFFE);  // [14/16] RDBUFF TDO ?= 0xABCD0001 (+ACK=OK)
//   ... 87% complete (14/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00001A044) SMASK (FFFFFFFFF);  // [15/16] TAR ← 0x00001A04
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [15/16] Read DRW from 0x00001A04  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF) TDO (ABCD00024) MASK (FFFFFFFFE);  // [15/16] RDBUFF TDO ?= 0xABCD0002 (+ACK=OK)
//   ... 93% complete (15/16 commands)
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00001A084) SMASK (FFFFFFFFF);  // [16/16] TAR ← 0x00001A08
SIR 10 TDI (2FF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF);  // [16/16] Read DRW from 0x00001A08  (TDO=stale)
SIR 10 TDI (2BF) SMASK (3FF);
SDR 36 TDI (00000000E) SMASK (FFFFFFFFF) TDO (ABCD00034) MASK (FFFFFFFFE);  // [16/16] RDBUFF TDO ?= 0xABCD0003 (+ACK=OK)
//   ... 100% complete (16/16 commands)
//   ✓ All 16 commands executed

// ======================================================================
// PHASE 7: JTAG Reset (clean shutdown)
// ======================================================================

RUNTEST 10 TCK;
STATE RESET IDLE;

