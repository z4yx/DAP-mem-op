// PHASE 4: Configure MEM-AP (CSW)
// ======================================================================

SIR 4 TDI (B) SMASK (F);
SDR 35 TDI (000000390) SMASK (7FFFFFFFF);  // CSW: 32-bit, auto-increment, DeviceEn, DbgSwEnable
SIR 4 TDI (A) SMASK (F);
SDR 35 TDI (000000003) SMASK (7FFFFFFFF);  // Read CTRL/STAT (wait for last operation)
RUNTEST 10 TCK;
