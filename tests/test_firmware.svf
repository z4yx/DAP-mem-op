// ============================================================================
//  SVF — Serial Vector Format
//  Target:  ARM Cortex-R52 (ARM IHI0031H / ADIv6)
//  Chain:   Single TAP (no daisy chain)
//  Generated by: svf_gen.py
// ============================================================================
TRST OFF;
ENDIR IDLE;
ENDDR IDLE;
STATE RESET IDLE;
// ======================================================================
// PHASE 1: JTAG Reset & Device Identification
// ======================================================================

RUNTEST 10 TCK;
SIR 4 TDI (E) SMASK (F);
SDR 32 TDI (00000000) SMASK (FFFFFFFF);  // Read IDCODE — TDO receives device ID
RUNTEST 10 TCK;
// ======================================================================
// PHASE 2: Power-Up the Debug & System Domains
// ======================================================================

SIR 4 TDI (A) SMASK (F);
SDR 35 TDI (280001002) SMASK (7FFFFFFFF);  // Request CDBGPWRUP + CSYSPWRUP, TRNCNT=512
RUNTEST 50 TCK;
SIR 4 TDI (A) SMASK (F);
SDR 35 TDI (000000003) SMASK (7FFFFFFFF);  // Read CTRL/STAT (result in next transaction)
SIR 4 TDI (A) SMASK (F);
SDR 35 TDI (000000007) SMASK (7FFFFFFFF);  // Read RDBUFF — TDO = CTRL/STAT value; check ACK bits
RUNTEST 10 TCK;
// ======================================================================
// PHASE 3: Select MEM-AP via DP.SELECT
// ======================================================================

SIR 4 TDI (A) SMASK (F);
SDR 35 TDI (000000004) SMASK (7FFFFFFFF);  // SELECT APSEL=0, APBANKSEL=0
RUNTEST 10 TCK;
// ======================================================================
// PHASE 4: Configure MEM-AP (CSW)
// ======================================================================

SIR 4 TDI (B) SMASK (F);
SDR 35 TDI (418000290) SMASK (7FFFFFFFF);  // CSW: 32-bit, auto-increment, DeviceEn, DbgSwEnable
RUNTEST 10 TCK;
